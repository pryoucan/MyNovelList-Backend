# Neon (written by `neon deploy` / `neon env pull`)
# App runtime: pooled connection (host has -pooler)
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Migrations (prisma migrate): direct connection
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (bucket "assets" in neon.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
PORT=5001

JWT_SECRETKEY=super_secret_random_string
ADMIN_KEY=another_super_secret_string

FRONTEND_URL=your_deployed_frontend_url_if_any

RESEND_API_KEY=re_xxxxxxxxx